# Kopieren nach .env und anpassen:  cp .env.example .env
TZ=Europe/Berlin

# MQTT-Login (wird von Mosquitto, Zigbee2MQTT und Home Assistant genutzt)
MQTT_USER=mqtt
MQTT_PASSWORD=bitte-aendern

# SONOFF Dongle Max – feste IP (DHCP-Reservierung im Router!) und TCP-Port
ZIGBEE_DONGLE_IP=192.168.1.10
ZIGBEE_DONGLE_PORT=6638
ZIGBEE_DONGLE_PASSWORD=zigbee-password
